      <data key="d0">곡성 하늘나리마을 주민</data>
      <data key="d1">단체</data>
      <data key="d2">곡성 하늘나리마을에 거주하며 다랑논에서 벼농사를 짓고 집집마다 토종벌을 키우는 주민들이다.</data>
      <data key="d3">tour-129317-chunk-000</data>
      <data key="d4">tour-129317.txt</data>
      <data key="d5">1791602085</data>
      <data key="d6" />
    </node>
    <node id="다랑논">
      <data key="d0">다랑논</data>
      <data key="d1">장소</data>
      <data key="d2">곡성 하늘나리마을 주민들이 벼농사를 짓는 계단식 논이다.</data>
      <data key="d3">tour-129317-chunk-000</data>
      <data key="d4">tour-129317.txt</data>
      <data key="d5">1791602085</data>
      <data key="d6" />
    </node>
    <node id="토종벌">
      <data key="d0">토종벌</data>
      <data key="d1">other</data>
      <data key="d2">곡성 하늘나리마을의 여러 가구가 집집마다 기르는 재래종 벌이다.</data>
      <data key="d3">tour-129317-chunk-000</data>
      <data key="d4">tour-129317.txt</data>
      <data key="d5">1791602085</data>
      <data key="d6" />
    </node>
    <node id="꿀">
      <data key="d0">꿀</data>
      <data key="d1">other</data>
      <data key="d2">토종벌이 주변 꽃에서 채취하며 곡성 하늘나리마을의 주요 소득원이자 특산물인 생산물이다.</data>
      <data key="d3">tour-129317-chunk-000</data>
      <data key="d4">tour-129317.txt</data>
