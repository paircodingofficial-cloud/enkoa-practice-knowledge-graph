<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d13" for="edge" attr.name="truncate" attr.type="string" />
  <key id="d12" for="edge" attr.name="created_at" attr.type="long" />
  <key id="d11" for="edge" attr.name="file_path" attr.type="string" />
  <key id="d10" for="edge" attr.name="source_id" attr.type="string" />
  <key id="d9" for="edge" attr.name="keywords" attr.type="string" />
  <key id="d8" for="edge" attr.name="description" attr.type="string" />
  <key id="d7" for="edge" attr.name="weight" attr.type="double" />
  <key id="d6" for="node" attr.name="truncate" attr.type="string" />
  <key id="d5" for="node" attr.name="created_at" attr.type="long" />
  <key id="d4" for="node" attr.name="file_path" attr.type="string" />
  <key id="d3" for="node" attr.name="source_id" attr.type="string" />
  <key id="d2" for="node" attr.name="description" attr.type="string" />
  <key id="d1" for="node" attr.name="entity_type" attr.type="string" />
  <key id="d0" for="node" attr.name="entity_id" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="앱 로그인">
      <data key="d0">앱 로그인</data>
      <data key="d1">서비스</data>
      <data key="d2">앱 사용자가 인증을 거쳐 앱에 접근하는 로그인 서비스이다.</data>
      <data key="d3">INC-0409-chunk-000</data>
      <data key="d4">INC-0409.txt</data>
      <data key="d5">1791602624</data>
      <data key="d6" />
    </node>
    <node id="앱 로그인 실패 장애">
      <data key="d0">앱 로그인 실패 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 4월 9일 07시 40분부터 08시 52분까지 앱 로그인 요청의 약 60%를 실패하게 만든 장애이다.</data>
      <data key="d3">INC-0409-chunk-000</data>
      <data key="d4">INC-0409.txt</data>
      <data key="d5">1791602624</data>
      <data key="d6" />
    </node>
    <node id="auth-token">
      <data key="d0">auth-token</data>
      <data key="d1">구성요소</data>
      <data key="d2">로그인 인증 토큰을 처리하고 redis-session에 새 세션을 저장하는 인증 토큰 서비스이다.&lt;SEP&gt;로그인 세션과 결제용 일회성 토큰을 발급하는 인증 토큰 서비스다.&lt;SEP&gt;결제플랫폼팀이 운영하는 인증 토큰 서비스이다.</data>
      <data key="d3">INC-0409-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0409.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="redis-session">
      <data key="d0">redis-session</data>
      <data key="d1">구성요소</data>
      <data key="d2">앱 로그인 세션을 캐시하고 저장하는 세션 캐시 서비스이다.&lt;SEP&gt;auth-token이 세션 정보를 저장하는 세션 캐시다.&lt;SEP&gt;로그인 세션을 저장하는 세션 캐시다.&lt;SEP&gt;redis-session은 세션 캐시 역할을 하는 공통 구성요소이다.</data>
      <data key="d3">INC-0409-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000</data>
      <data key="d4">INC-0409.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-02.txt</data>
      <data key="d5">1791602883</data>
      <data key="d6" />
    </node>
    <node id="클라이언트 인증서">
      <data key="d0">클라이언트 인증서</data>
      <data key="d1">구성요소</data>
      <data key="d2">auth-token이 redis-session에 접속할 때 사용하는 인증서로, 1년 전 수동 발급되었으며 만료 일정이 등록되지 않았다.</data>
      <data key="d3">INC-0409-chunk-000</data>
      <data key="d4">INC-0409.txt</data>
      <data key="d5">1791602624</data>
      <data key="d6" />
    </node>
    <node id="TLS 핸드셰이크 오류">
      <data key="d0">TLS 핸드셰이크 오류</data>
      <data key="d1">장애</data>
      <data key="d2">auth-token 로그에서 반복적으로 발생한 TLS 연결 협상 오류이다.</data>
      <data key="d3">INC-0409-chunk-000</data>
      <data key="d4">INC-0409.txt</data>
      <data key="d5">1791602624</data>
      <data key="d6" />
    </node>
    <node id="간편결제 화면">
      <data key="d0">간편결제 화면</data>
      <data key="d1">구성요소</data>
      <data key="d2">새로 로그인하거나 세션이 끊긴 사용자가 접근하지 못한 앱의 간편결제 화면이다.</data>
      <data key="d3">INC-0409-chunk-000</data>
      <data key="d4">INC-0409.txt</data>
      <data key="d5">1791602624</data>
      <data key="d6" />
    </node>
    <node id="고객센터">
      <data key="d0">고객센터</data>
      <data key="d1">팀</data>
      <data key="d2">앱 로그인 실패 장애와 관련된 사용자 문의를 접수하는 지원 조직이다.&lt;SEP&gt;알림 미수신 문의를 접수하고 장애 상황을 확인한 고객 지원 조직이다.</data>
      <data key="d3">INC-0409-chunk-000&lt;SEP&gt;INC-0909-chunk-000</data>
      <data key="d4">INC-0409.txt&lt;SEP&gt;INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="정산 금액 오차 장애">
      <data key="d0">정산 금액 오차 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 4월 17일 발생한 장애로, 2026년 4월 16일 거래분의 가맹점 정산 금액이 실제보다 많거나 적게 계산되었고 지급 지연이 발생했다.</data>
      <data key="d3">INC-0417-chunk-000</data>
      <data key="d4">INC-0417.txt</data>
      <data key="d5">1791602638</data>
      <data key="d6" />
    </node>
    <node id="가맹점">
      <data key="d0">가맹점</data>
      <data key="d1">other</data>
      <data key="d2">정산 금액 오차의 영향을 받은 1,284곳의 거래처로, 오차를 바로잡는 동안 하루 동안 지급이 지연되었다.&lt;SEP&gt;카드 거래에 대한 지급을 받는 사업자로, 약 2,100곳이 지급 지연의 영향을 받았다.</data>
      <data key="d3">INC-0417-chunk-000&lt;SEP&gt;INC-0812-chunk-000</data>
      <data key="d4">INC-0417.txt&lt;SEP&gt;INC-0812.txt</data>
      <data key="d5">1791602774</data>
      <data key="d6" />
    </node>
    <node id="settle-batch">
      <data key="d0">settle-batch</data>
      <data key="d1">구성요소</data>
      <data key="d2">정산 배치를 수행하는 구성요소로, 실행 완료 후 대사 결과에서 큰 차액이 확인되었다.&lt;SEP&gt;가맹점 정산을 처리하는 배치 작업으로, 병렬 처리 개수 증가 후 ledger-db 커넥션을 얻지 못해 작업이 지연되었다.&lt;SEP&gt;settle-batch는 매일 새벽 전날 거래를 가맹점별로 모아 정산 금액을 계산하고, 계산 결과를 정산 파일로 남기는 정산 배치 서비스이다.&lt;SEP&gt;정산개발팀이 운영하는 정산 배치 서비스이다.&lt;SEP&gt;정산 배치를 처리하는 운영 구성요소이며 병렬 처리 개수가 조정되었다.</data>
      <data key="d3">INC-0417-chunk-000&lt;SEP&gt;INC-0612-chunk-000&lt;SEP&gt;CAT-02-chunk-000&lt;SEP&gt;ORG-01-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0417.txt&lt;SEP&gt;INC-0612.txt&lt;SEP&gt;CAT-02.txt&lt;SEP&gt;ORG-01.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="batch-scheduler">
      <data key="d0">batch-scheduler</data>
      <data key="d1">구성요소</data>
      <data key="d2">정산 작업의 실행을 예약하는 구성요소로, 실행 기준 시간대가 UTC로 변경되어 거래 날짜 경계에 오류를 일으켰다.&lt;SEP&gt;batch-scheduler는 정산, 대사, 통계 집계와 같은 야간 작업의 실행 순서와 시각 및 작업 간 선후 관계를 관리하는 서비스이다.&lt;SEP&gt;정산개발팀이 운영하는 배치 스케줄러이다.&lt;SEP&gt;배치 작업을 스케줄링하는 운영 구성요소이며 기본 시간대 값이 UTC로 변경되었다.</data>
      <data key="d3">INC-0417-chunk-000&lt;SEP&gt;CAT-02-chunk-000&lt;SEP&gt;ORG-01-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0417.txt&lt;SEP&gt;CAT-02.txt&lt;SEP&gt;ORG-01.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="CHG-2604-02">
      <data key="d0">CHG-2604-02</data>
      <data key="d1">other</data>
      <data key="d2">전날 반영된 변경 요청으로, batch-scheduler의 시간대를 UTC로 변경했다.&lt;SEP&gt;batch-scheduler의 기본 시간대를 UTC로 변경한 2026년 4월 16일 운영 변경 기록이다.</data>
      <data key="d3">INC-0417-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0417.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="ledger-db">
      <data key="d0">ledger-db</data>
      <data key="d1">구성요소</data>
      <data key="d2">원장 데이터를 저장하는 구성요소로, 4월 16일 거래를 다시 읽어 재정산하는 데 사용되었다.&lt;SEP&gt;거래 내역 조회 쿼리를 처리하는 원장 데이터베이스이다.&lt;SEP&gt;원장 데이터를 저장하는 데이터베이스로, 커넥션 풀이 상한에 도달해 settle-batch 작업을 대기시켰다.&lt;SEP&gt;결제 승인 결과를 기록하는 원장 데이터베이스다.&lt;SEP&gt;결제, 정산, 포인트의 모든 거래 원장과 쿠폰 발급 한도를 저장하는 주 데이터베이스다.&lt;SEP&gt;ledger-db는 원장 DB 역할을 하는 공통 구성요소이다.</data>
      <data key="d3">INC-0417-chunk-000&lt;SEP&gt;INC-0518-chunk-000&lt;SEP&gt;INC-0612-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000</data>
      <data key="d4">INC-0417.txt&lt;SEP&gt;INC-0518.txt&lt;SEP&gt;INC-0612.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-02.txt</data>
      <data key="d5">1791602883</data>
      <data key="d6" />
    </node>
    <node id="UTC">
      <data key="d0">UTC</data>
      <data key="d1">other</data>
      <data key="d2">batch-scheduler에 잘못 설정되어 하루 거래를 자르는 경계를 아홉 시간 어긋나게 만든 시간대 값이다.</data>
      <data key="d3">INC-0417-chunk-000</data>
      <data key="d4">INC-0417.txt</data>
      <data key="d5">1791602638</data>
      <data key="d6" />
    </node>
    <node id="KST">
      <data key="d0">KST</data>
      <data key="d1">other</data>
      <data key="d2">batch-scheduler의 시간대를 복구하기 위해 적용한 시간대 값이다.</data>
      <data key="d3">INC-0417-chunk-000</data>
      <data key="d4">INC-0417.txt</data>
      <data key="d5">1791602638</data>
      <data key="d6" />
    </node>
    <node id="카드 결제 승인 지연 장애">
      <data key="d0">카드 결제 승인 지연 장애</data>
      <data key="d1">장애</data>
      <data key="d2">카드 결제 응답 시간이 2026년 4월 28일 12시 5분부터 12시 41분까지 지연되어 약 7,900건의 결제 실패를 유발한 장애이다.</data>
      <data key="d3">INC-0428-chunk-000</data>
      <data key="d4">INC-0428.txt</data>
      <data key="d5">1791602652</data>
      <data key="d6" />
    </node>
    <node id="카드 결제">
      <data key="d0">카드 결제</data>
      <data key="d1">서비스</data>
      <data key="d2">한빛PG를 거쳐 승인되는 결제 서비스로, 장애 기간 동안 응답 시간이 평균 0.8초에서 9초로 증가했다.</data>
      <data key="d3">INC-0428-chunk-000</data>
      <data key="d4">INC-0428.txt</data>
      <data key="d5">1791602652</data>
      <data key="d6" />
    </node>
    <node id="한빛PG">
      <data key="d0">한빛PG</data>
      <data key="d1">서비스</data>
      <data key="d2">카드 결제 승인을 제공하는 외부 PG사로, 승인 서버 증설 작업 중 처리 용량이 감소했다.&lt;SEP&gt;결제 승인 결과를 통보하는 외부 PG사이며, 통보 서버 점검 중 승인 결과 통보를 묶어 지연 전송했다.&lt;SEP&gt;pg-connector가 국내 카드 결제 승인, 취소, 결과 확인 전문을 전달하는 외부 PG사다.</data>
      <data key="d3">INC-0428-chunk-000&lt;SEP&gt;INC-0703-chunk-000&lt;SEP&gt;CAT-01-chunk-000</data>
      <data key="d4">INC-0428.txt&lt;SEP&gt;INC-0703.txt&lt;SEP&gt;CAT-01.txt</data>
      <data key="d5">1791602817</data>
      <data key="d6" />
    </node>
    <node id="다온PG">
      <data key="d0">다온PG</data>
      <data key="d1">서비스</data>
      <data key="d2">신규 카드 결제의 대체 라우팅 대상으로 사용된 다른 PG사이다.&lt;SEP&gt;해외 카드 승인을 처리하는 외부 PG사로, 해외 카드사 연결 구간에서 응답 지연이 발생했다.&lt;SEP&gt;pg-connector가 국내 카드와 해외 카드 결제 전문을 전달하는 외부 PG사다.</data>
      <data key="d3">INC-0428-chunk-000&lt;SEP&gt;INC-0527-chunk-000&lt;SEP&gt;CAT-01-chunk-000</data>
      <data key="d4">INC-0428.txt&lt;SEP&gt;INC-0527.txt&lt;SEP&gt;CAT-01.txt</data>
      <data key="d5">1791602817</data>
      <data key="d6" />
    </node>
    <node id="pg-connector">
      <data key="d0">pg-connector</data>
      <data key="d1">구성요소</data>
      <data key="d2">PG사 연동 모듈로, 한빛PG 호출 대기 시간이 30초로 설정되어 있었다.&lt;SEP&gt;해외 카드 결제 요청을 다온PG에 전달하고 승인 응답을 수신하는 PG 연동 모듈이다.&lt;SEP&gt;PG사의 승인 결과 통보를 연동하는 결제 시스템 모듈이다.&lt;SEP&gt;외부 PG사에 결제 승인, 취소, 결과 확인 전문을 전달하는 PG 연동 모듈이다.&lt;SEP&gt;결제플랫폼팀이 운영하는 PG 연동 모듈이다.</data>
      <data key="d3">INC-0428-chunk-000&lt;SEP&gt;INC-0527-chunk-000&lt;SEP&gt;INC-0703-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0428.txt&lt;SEP&gt;INC-0527.txt&lt;SEP&gt;INC-0703.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="pay-gateway">
      <data key="d0">pay-gateway</data>
      <data key="d1">구성요소</data>
      <data key="d2">카드 결제를 처리하는 결제 게이트웨이로, 지연된 PG사 응답 때문에 작업 스레드가 붙잡혔다.&lt;SEP&gt;앱, 웹, 가맹점 서버의 결제 요청을 받고 인증, 이상거래 판정, PG 승인 요청을 조정하는 결제 게이트웨이다.&lt;SEP&gt;결제플랫폼팀이 운영하는 결제 게이트웨이 서비스이다.&lt;SEP&gt;결제 요청을 처리하는 결제 게이트웨이 구성요소이며 처리 스레드 상한이 조정되었다.</data>
      <data key="d3">INC-0428-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;ORG-01-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0428.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;ORG-01.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="승인 서버">
      <data key="d0">승인 서버</data>
      <data key="d1">구성요소</data>
      <data key="d2">한빛PG에서 카드 결제 승인 처리를 담당하는 서버로, 작업 중 처리 용량이 줄었다.</data>
      <data key="d3">INC-0428-chunk-000</data>
      <data key="d4">INC-0428.txt</data>
      <data key="d5">1791602652</data>
      <data key="d6" />
    </node>
    <node id="앱">
      <data key="d0">앱</data>
      <data key="d1">서비스</data>
      <data key="d2">카드 결제 요청의 대기 한도를 적용하는 애플리케이션으로, 대기 한도를 넘은 결제가 실패했다.&lt;SEP&gt;보안 연결 오류로 인해 결제 요청이 실패한 애플리케이션 서비스이다.</data>
      <data key="d3">INC-0428-chunk-000&lt;SEP&gt;INC-0804-chunk-000</data>
      <data key="d4">INC-0428.txt&lt;SEP&gt;INC-0804.txt</data>
      <data key="d5">1791602763</data>
      <data key="d6" />
    </node>
    <node id="포인트 적립 지연 장애">
      <data key="d0">포인트 적립 지연 장애</data>
      <data key="d1">장애</data>
      <data key="d2">포인트 적립 지연 장애는 2026년 5월 13일 18시부터 21시 30분까지 결제 후 포인트 적립과 적립 완료 알림을 지연시킨 장애이다.</data>
      <data key="d3">INC-0513-chunk-000</data>
      <data key="d4">INC-0513.txt</data>
      <data key="d5">1791602662</data>
      <data key="d6" />
    </node>
    <node id="point-engine">
      <data key="d0">point-engine</data>
      <data key="d1">구성요소</data>
      <data key="d2">point-engine은 포인트 적립을 처리하는 포인트 적립 엔진이다.&lt;SEP&gt;포인트 적립을 처리하는 엔진으로, 중복 이벤트 규칙에 따라 같은 거래에 포인트 적립 이력을 두 번 생성했다.&lt;SEP&gt;결제 완료 이벤트를 받아 적립 규칙에 따라 포인트를 적립하고, 적립 이력을 ledger-db에 기록하는 포인트 적립 엔진이다.&lt;SEP&gt;포인트서비스팀이 운영하는 포인트 적립 엔진이다.&lt;SEP&gt;포인트 적립을 처리하는 운영 구성요소이며 적립 처리 스레드 수와 프로모션용 적립 규칙 파일이 변경되었다.</data>
      <data key="d3">INC-0513-chunk-000&lt;SEP&gt;INC-0715-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-01-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0513.txt&lt;SEP&gt;INC-0715.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-01.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="DB 커넥션 풀">
      <data key="d0">DB 커넥션 풀</data>
      <data key="d1">구성요소</data>
      <data key="d2">DB 커넥션 풀은 point-engine이 데이터베이스 요청에 사용할 수 있는 커넥션을 관리하며, 장애 당시 40개가 모두 점유되었다.</data>
      <data key="d3">INC-0513-chunk-000</data>
      <data key="d4">INC-0513.txt</data>
      <data key="d5">1791602662</data>
      <data key="d6" />
    </node>
    <node id="적립 처리 스레드">
      <data key="d0">적립 처리 스레드</data>
      <data key="d1">구성요소</data>
      <data key="d2">적립 처리 스레드는 point-engine의 포인트 적립 작업을 처리하며, CHG-2605-01 적용으로 수가 두 배로 늘어났다.</data>
      <data key="d3">INC-0513-chunk-000</data>
      <data key="d4">INC-0513.txt</data>
      <data key="d5">1791602662</data>
      <data key="d6" />
    </node>
    <node id="인스턴스">
      <data key="d0">인스턴스</data>
      <data key="d1">구성요소</data>
      <data key="d2">인스턴스는 point-engine의 처리 용량을 구성하며, 장애 대응 과정에서 수가 늘어났다.</data>
      <data key="d3">INC-0513-chunk-000</data>
      <data key="d4">INC-0513.txt</data>
      <data key="d5">1791602662</data>
      <data key="d6" />
    </node>
    <node id="CHG-2605-01">
      <data key="d0">CHG-2605-01</data>
      <data key="d1">other</data>
      <data key="d2">CHG-2605-01은 전날 적립 처리 스레드 수를 두 배로 늘린 변경 사항이다.&lt;SEP&gt;point-engine의 적립 처리 스레드 수를 16개에서 32개로 늘린 2026년 5월 12일 운영 변경 기록이다.</data>
      <data key="d3">INC-0513-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0513.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="포인트 잔액 조회 오류 장애">
      <data key="d0">포인트 잔액 조회 오류 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 5월 18일 10시 20분부터 11시 5분까지 앱의 포인트 화면에서 잔액 조회 오류를 발생시킨 장애이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="point-wallet">
      <data key="d0">point-wallet</data>
      <data key="d1">구성요소</data>
      <data key="d2">포인트 잔액 요청을 처리하는 포인트 지갑 API 서비스이다.&lt;SEP&gt;앱의 포인트 화면 조회와 결제 시 포인트 차감 요청을 처리하는 포인트 지갑 API다.&lt;SEP&gt;포인트서비스팀이 운영하는 포인트 지갑 API이다.</data>
      <data key="d3">INC-0518-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0518.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="거래 내역 화면 개선 기능">
      <data key="d0">거래 내역 화면 개선 기능</data>
      <data key="d1">구성요소</data>
      <data key="d2">거래 내역 화면에 추가된 기능으로, 배포 직후 내역 조회 쿼리를 전송했다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="내역 조회 쿼리">
      <data key="d0">내역 조회 쿼리</data>
      <data key="d1">구성요소</data>
      <data key="d2">ledger-db에서 평균 4초가 걸렸으며 인덱스가 없어 point-wallet의 커넥션 풀을 점유한 쿼리이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="잔액 조회">
      <data key="d0">잔액 조회</data>
      <data key="d1">구성요소</data>
      <data key="d2">포인트 잔액을 확인하기 위해 point-wallet에 요청하는 기능이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="커넥션 풀">
      <data key="d0">커넥션 풀</data>
      <data key="d1">구성요소</data>
      <data key="d2">내역 조회와 잔액 조회가 함께 사용한 point-wallet의 연결 자원 풀이다.&lt;SEP&gt;카드사별 대사 작업이 공유하는 연결 자원으로, 장시간 트랜잭션으로 인해 고갈되었다.</data>
      <data key="d3">INC-0518-chunk-000&lt;SEP&gt;INC-0812-chunk-000</data>
      <data key="d4">INC-0518.txt&lt;SEP&gt;INC-0812.txt</data>
      <data key="d5">1791602774</data>
      <data key="d6" />
    </node>
    <node id="기능 플래그">
      <data key="d0">기능 플래그</data>
      <data key="d1">구성요소</data>
      <data key="d2">거래 내역 화면 개선 기능을 비활성화하는 데 사용된 제어 장치이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="인덱스">
      <data key="d0">인덱스</data>
      <data key="d1">구성요소</data>
      <data key="d2">내역 조회 쿼리의 처리 속도를 개선하기 위해 추가된 데이터베이스 인덱스이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="조회 전용 커넥션 풀">
      <data key="d0">조회 전용 커넥션 풀</data>
      <data key="d1">구성요소</data>
      <data key="d2">무거운 조회 작업을 잔액 요청과 분리하기 위해 별도로 둘 예정인 커넥션 풀이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="쿼리 실행 계획 확인 단계">
      <data key="d0">쿼리 실행 계획 확인 단계</data>
      <data key="d1">구성요소</data>
      <data key="d2">운영과 같은 규모의 데이터로 쿼리 성능을 검증하기 위해 배포 점검에 추가할 단계이다.</data>
      <data key="d3">INC-0518-chunk-000</data>
      <data key="d4">INC-0518.txt</data>
      <data key="d5">1791602678</data>
      <data key="d6" />
    </node>
    <node id="해외 카드 결제 실패 장애">
      <data key="d0">해외 카드 결제 실패 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 5월 27일 01시 10분부터 03시 40분까지 해외 발급 카드의 승인 실패가 이어진 장애로, 약 2,300건의 실패 거래가 발생했다.</data>
      <data key="d3">INC-0527-chunk-000</data>
      <data key="d4">INC-0527.txt</data>
      <data key="d5">1791602691</data>
      <data key="d6" />
    </node>
    <node id="해외 카드 결제">
      <data key="d0">해외 카드 결제</data>
      <data key="d1">서비스</data>
      <data key="d2">해외에서 발급된 카드의 결제를 승인하는 결제 서비스로, 다온PG를 통해 해외 카드 승인을 처리했다.</data>
      <data key="d3">INC-0527-chunk-000</data>
      <data key="d4">INC-0527.txt</data>
      <data key="d5">1791602691</data>
      <data key="d6" />
    </node>
    <node id="해외 카드사 연결 구간">
      <data key="d0">해외 카드사 연결 구간</data>
      <data key="d1">구성요소</data>
      <data key="d2">다온PG와 해외 카드사 사이에서 해외 카드 승인 요청과 응답이 오가는 연결 구간이다.</data>
      <data key="d3">INC-0527-chunk-000</data>
      <data key="d4">INC-0527.txt</data>
      <data key="d5">1791602691</data>
      <data key="d6" />
    </node>
    <node id="해외 직구 가맹점">
      <data key="d0">해외 직구 가맹점</data>
      <data key="d1">other</data>
      <data key="d2">해외 직접구매 거래를 처리하는 가맹점 유형으로, 장애 기간의 결제 실패가 집중된 대상이다.</data>
      <data key="d3">INC-0527-chunk-000</data>
      <data key="d4">INC-0527.txt</data>
      <data key="d5">1791602691</data>
      <data key="d6" />
    </node>
    <node id="여행 플랫폼 가맹점">
      <data key="d0">여행 플랫폼 가맹점</data>
      <data key="d1">other</data>
      <data key="d2">여행 플랫폼 거래를 처리하는 가맹점 유형으로, 장애 기간의 결제 실패가 집중된 대상이다.</data>
      <data key="d3">INC-0527-chunk-000</data>
      <data key="d4">INC-0527.txt</data>
      <data key="d5">1791602691</data>
      <data key="d6" />
    </node>
    <node id="가맹점 연동 결제 거절 장애">
      <data key="d0">가맹점 연동 결제 거절 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 6월 3일 9시부터 10시 15분까지 가맹점 주문 결제 요청을 거절한 장애이다.</data>
      <data key="d3">INC-0603-chunk-000</data>
      <data key="d4">INC-0603.txt</data>
      <data key="d5">1791602706</data>
      <data key="d6" />
    </node>
    <node id="merchant-api">
      <data key="d0">merchant-api</data>
      <data key="d1">구성요소</data>
      <data key="d2">가맹점 서버가 주문 결제 요청을 보내는 가맹점 API이다.&lt;SEP&gt;가맹점 서버의 주문 결제, 환불, 거래 확인 요청을 접수하는 가맹점 API다.&lt;SEP&gt;결제플랫폼팀이 운영하는 가맹점 API이다.</data>
      <data key="d3">INC-0603-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0603.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="가맹점 서버">
      <data key="d0">가맹점 서버</data>
      <data key="d1">구성요소</data>
      <data key="d2">merchant-api로 주문 결제 요청을 전송하는 가맹점 측 서버이다.</data>
      <data key="d3">INC-0603-chunk-000</data>
      <data key="d4">INC-0603.txt</data>
      <data key="d5">1791602706</data>
      <data key="d6" />
    </node>
    <node id="온라인 가맹점">
      <data key="d0">온라인 가맹점</data>
      <data key="d1">other</data>
      <data key="d2">장애 기간 동안 약 3,400곳에서 결제 실패를 경험한 온라인 판매 사업자이다.</data>
      <data key="d3">INC-0603-chunk-000</data>
      <data key="d4">INC-0603.txt</data>
      <data key="d5">1791602706</data>
      <data key="d6" />
    </node>
    <node id="api-edge">
      <data key="d0">api-edge</data>
      <data key="d1">구성요소</data>
      <data key="d2">외부 API 관문으로서 가맹점 전용 도메인 인증서가 연결된 구성요소이다.&lt;SEP&gt;외부 API 관문으로서 만료된 와일드카드 인증서가 연결된 구성요소이다.&lt;SEP&gt;가맹점 API로 들어오는 외부 요청을 전달하는 외부 API 관문이다.&lt;SEP&gt;외부에서 유입되는 모든 API 요청이 최초로 거치는 외부 API 관문이다.&lt;SEP&gt;api-edge는 외부 API 관문 역할을 하는 공통 구성요소이다.</data>
      <data key="d3">INC-0603-chunk-000&lt;SEP&gt;INC-0804-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000</data>
      <data key="d4">INC-0603.txt&lt;SEP&gt;INC-0804.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-02.txt</data>
      <data key="d5">1791602883</data>
