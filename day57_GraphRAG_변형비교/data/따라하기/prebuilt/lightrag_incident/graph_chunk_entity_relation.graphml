      <data key="d0">payout-api</data>
      <data key="d1">구성요소</data>
      <data key="d2">지급 대상 파일 개수를 점검하고 파일 수 부족을 경보로 알리는 지급 API이다.&lt;SEP&gt;payout-api는 정산 파일을 받아 은행 펌뱅킹을 통한 가맹점 계좌 입금을 요청하는 서비스이다.&lt;SEP&gt;정산개발팀이 운영하는 지급 API이다.</data>
      <data key="d3">INC-0812-chunk-000&lt;SEP&gt;CAT-02-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0812.txt&lt;SEP&gt;CAT-02.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="recon-worker">
      <data key="d0">recon-worker</data>
      <data key="d1">구성요소</data>
      <data key="d2">카드사 매입 내역 대조 작업을 수행하는 거래 대사 작업기이다.&lt;SEP&gt;recon-worker는 카드사와 외부 PG사가 보낸 매입 내역을 거래 기록과 대조하고 대사 결과를 정산 파일에 반영하는 거래 대사 작업 서비스이다.&lt;SEP&gt;정산개발팀이 운영하는 거래 대사 작업기이다.&lt;SEP&gt;거래 대사를 수행하는 작업기 구성요소이며 카드사별 커넥션 상한을 분리하는 2.3 버전이 배포되었다.</data>
      <data key="d3">INC-0812-chunk-000&lt;SEP&gt;CAT-02-chunk-000&lt;SEP&gt;ORG-01-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0812.txt&lt;SEP&gt;CAT-02.txt&lt;SEP&gt;ORG-01.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="카드사별 대사 작업">
      <data key="d0">카드사별 대사 작업</data>
      <data key="d1">구성요소</data>
      <data key="d2">카드사별 매입 내역을 대조하는 작업으로, 하나의 커넥션 풀을 공유하며 일부 작업이 시간 초과로 실패했다.</data>
      <data key="d3">INC-0812-chunk-000</data>
      <data key="d4">INC-0812.txt</data>
      <data key="d5">1791602774</data>
      <data key="d6" />
    </node>
    <node id="정산 파일">
      <data key="d0">정산 파일</data>
      <data key="d1">구성요소</data>
      <data key="d2">카드 거래 정산을 위해 생성되는 파일로, 두 카드사의 파일이 생성되지 않았다.&lt;SEP&gt;정산 파일은 settle-batch가 계산 결과를 기록하고 payout-api에 전달하는 결과 파일이다.</data>
      <data key="d3">INC-0812-chunk-000&lt;SEP&gt;CAT-02-chunk-000</data>
      <data key="d4">INC-0812.txt&lt;SEP&gt;CAT-02.txt</data>
      <data key="d5">1791602831</data>
      <data key="d6" />
    </node>
    <node id="카드사">
      <data key="d0">카드사</data>
      <data key="d1">other</data>
      <data key="d2">매입 내역과 카드 거래를 제공하는 주체로, 두 카드사의 대사 작업과 정산 파일 생성에 문제가 발생했다.&lt;SEP&gt;카드사는 recon-worker에 매입 내역을 보내는 외부 거래 기관이다.</data>
      <data key="d3">INC-0812-chunk-000&lt;SEP&gt;CAT-02-chunk-000</data>
      <data key="d4">INC-0812.txt&lt;SEP&gt;CAT-02.txt</data>
      <data key="d5">1791602831</data>
      <data key="d6" />
    </node>
    <node id="지급 일정">
      <data key="d0">지급 일정</data>
      <data key="d1">서비스</data>
      <data key="d2">정산 결과에 따라 가맹점에 지급하는 일정으로, 은행 마감 이후 다음 영업일로 미뤄졌다.</data>
      <data key="d3">INC-0812-chunk-000</data>
      <data key="d4">INC-0812.txt</data>
      <data key="d5">1791602774</data>
      <data key="d6" />
    </node>
    <node id="신규 가입 혜택 미지급 장애">
      <data key="d0">신규 가입 혜택 미지급 장애</data>
      <data key="d1">장애</data>
      <data key="d2">신규 가입 사용자 약 4,700명에게 2026년 8월 26일 0시부터 1시 20분까지 가입 축하 쿠폰이 지급되지 않은 장애이다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="coupon-svc">
      <data key="d0">coupon-svc</data>
      <data key="d1">구성요소</data>
      <data key="d2">가입 축하 쿠폰 발급을 처리하는 쿠폰 서비스로, 월말 프로모션 시작과 함께 응답 시간이 증가하고 발급 실패율이 70%를 초과했다.&lt;SEP&gt;쿠폰 발급과 회수를 담당하며, 쿠폰 발급 한도와 쿠폰 원장을 ledger-db에 저장하는 쿠폰 서비스다.&lt;SEP&gt;포인트서비스팀이 운영하는 쿠폰 서비스이다.</data>
      <data key="d3">INC-0826-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">INC-0826.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="로컬 캐시">
      <data key="d0">로컬 캐시</data>
      <data key="d1">구성요소</data>
      <data key="d2">coupon-svc 프로세스 내부에서 발급 한도 정보를 저장하며, 자정에 캐시 항목이 동시에 만료되었다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="발급 한도 정보">
      <data key="d0">발급 한도 정보</data>
      <data key="d1">구성요소</data>
      <data key="d2">coupon-svc가 쿠폰 발급 요청을 처리할 때 사용하는 한도 정보로, 로컬 캐시 만료 이후 요청마다 재계산되었다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="월말 프로모션">
      <data key="d0">월말 프로모션</data>
      <data key="d1">other</data>
      <data key="d2">2026년 8월 26일 0시에 시작되어 coupon-svc의 쿠폰 발급 요청을 증가시킨 프로모션이다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="가입 축하 쿠폰">
      <data key="d0">가입 축하 쿠폰</data>
      <data key="d1">서비스</data>
      <data key="d2">신규 가입 사용자에게 지급되는 가입 혜택 쿠폰이다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="신규 가입 사용자">
      <data key="d0">신규 가입 사용자</data>
      <data key="d1">other</data>
      <data key="d2">장애 발생 시간에 가입 절차를 정상적으로 완료했지만 가입 축하 쿠폰을 지급받지 못한 사용자 집단이다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="임시 스크립트">
      <data key="d0">임시 스크립트</data>
      <data key="d1">구성요소</data>
      <data key="d2">발급 한도 정보를 미리 채워 장애를 1시 20분에 회복시킨 임시 실행 도구이다.</data>
      <data key="d3">INC-0826-chunk-000</data>
      <data key="d4">INC-0826.txt</data>
      <data key="d5">1791602788</data>
      <data key="d6" />
    </node>
    <node id="알림 미발송 장애">
      <data key="d0">알림 미발송 장애</data>
      <data key="d1">장애</data>
      <data key="d2">2026년 9월 8일 18시부터 9월 9일 8시까지 결제 완료, 포인트 적립, 정산 완료 안내 등의 알림 약 120만 건이 발송되지 않은 장애이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="kafka-main">
      <data key="d0">kafka-main</data>
      <data key="d1">구성요소</data>
      <data key="d2">알림 메시지를 전달하는 메인 메시지 브로커이다.&lt;SEP&gt;결제 완료 이벤트를 전달하고 risk-engine이 결제 이벤트를 읽는 메인 메시지 브로커다.&lt;SEP&gt;서비스 사이의 이벤트를 전달하는 메인 메시지 브로커이며, 토픽별 보존 기간은 config-center의 설정을 따른다.&lt;SEP&gt;kafka-main은 메인 메시지 브로커 역할을 하는 공통 구성요소이다.&lt;SEP&gt;메인 메시지 브로커 구성요소이며 notify.events 토픽의 보존 기간 값이 변경되었다.</data>
      <data key="d3">INC-0909-chunk-000&lt;SEP&gt;CAT-01-chunk-000&lt;SEP&gt;CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0909.txt&lt;SEP&gt;CAT-01.txt&lt;SEP&gt;CAT-03.txt&lt;SEP&gt;ORG-02.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="알림 토픽">
      <data key="d0">알림 토픽</data>
      <data key="d1">구성요소</data>
      <data key="d2">kafka-main에서 알림 메시지를 전달하는 토픽이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="토픽 보존 기간">
      <data key="d0">토픽 보존 기간</data>
      <data key="d1">구성요소</data>
      <data key="d2">알림 토픽에 메시지를 보관하는 기간 설정으로, 장애 당시 약 10분으로 잘못 설정되었고 이후 7일로 복구되었다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="CHG-2609-02">
      <data key="d0">CHG-2609-02</data>
      <data key="d1">other</data>
      <data key="d2">2026년 9월 8일 반영된 알림 토픽 설정 변경 항목이다.&lt;SEP&gt;kafka-main의 notify.events 토픽 보존 기간 값을 변경한 2026년 9월 8일 운영 변경 기록이다.</data>
      <data key="d3">INC-0909-chunk-000&lt;SEP&gt;CHG-01-chunk-000</data>
      <data key="d4">INC-0909.txt&lt;SEP&gt;CHG-01.txt</data>
      <data key="d5">1791602903</data>
      <data key="d6" />
    </node>
    <node id="푸시 알림">
      <data key="d0">푸시 알림</data>
      <data key="d1">서비스</data>
      <data key="d2">결제 완료, 포인트 적립, 정산 완료 안내 등에 사용되는 푸시 방식의 알림이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="문자 알림">
      <data key="d0">문자 알림</data>
      <data key="d1">서비스</data>
      <data key="d2">결제 완료, 포인트 적립, 정산 완료 안내 등에 사용되는 문자 방식의 알림이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="앱 알림함">
      <data key="d0">앱 알림함</data>
      <data key="d1">서비스</data>
      <data key="d2">이미 삭제된 결제 완료 알림 내역을 대체하여 사용자에게 보여 준 앱 내부 알림 서비스이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="소비 전 삭제 메시지 경보 지표">
      <data key="d0">소비 전 삭제 메시지 경보 지표</data>
      <data key="d1">구성요소</data>
      <data key="d2">소비되지 않고 삭제된 메시지 수를 감시하고 경보를 발생시키는 운영 지표이다.</data>
      <data key="d3">INC-0909-chunk-000</data>
      <data key="d4">INC-0909.txt</data>
      <data key="d5">1791602803</data>
      <data key="d6" />
    </node>
    <node id="risk-engine">
      <data key="d0">risk-engine</data>
      <data key="d1">구성요소</data>
      <data key="d2">결제 이벤트를 기반으로 이상 패턴을 학습하고 결제 시점에 이상거래 판정을 실시간으로 제공하는 엔진이다.&lt;SEP&gt;리스크관리팀이 운영하는 이상거래 탐지 엔진이다.</data>
      <data key="d3">CAT-01-chunk-000&lt;SEP&gt;ORG-01-chunk-000</data>
      <data key="d4">CAT-01.txt&lt;SEP&gt;ORG-01.txt</data>
      <data key="d5">1791602862</data>
      <data key="d6" />
    </node>
    <node id="원장디비">
      <data key="d0">원장디비</data>
      <data key="d1">구성요소</data>
      <data key="d2">원장디비는 settle-batch와 recon-worker가 거래 원장 및 거래 기록을 읽는 데이터 저장 구성요소이다.</data>
      <data key="d3">CAT-02-chunk-000</data>
      <data key="d4">CAT-02.txt</data>
      <data key="d5">1791602831</data>
      <data key="d6" />
    </node>
    <node id="외부 PG사">
      <data key="d0">외부 PG사</data>
      <data key="d1">other</data>
      <data key="d2">외부 PG사는 recon-worker에 매입 내역을 보내는 외부 결제 기관이다.</data>
      <data key="d3">CAT-02-chunk-000</data>
      <data key="d4">CAT-02.txt</data>
      <data key="d5">1791602831</data>
      <data key="d6" />
    </node>
    <node id="은행 펌뱅킹">
      <data key="d0">은행 펌뱅킹</data>
      <data key="d1">구성요소</data>
      <data key="d2">은행 펌뱅킹은 payout-api의 가맹점 계좌 입금 요청을 처리하는 은행 연계 구성요소이다.</data>
      <data key="d3">CAT-02-chunk-000</data>
      <data key="d4">CAT-02.txt</data>
      <data key="d5">1791602831</data>
      <data key="d6" />
    </node>
    <node id="redis-point">
      <data key="d0">redis-point</data>
      <data key="d1">구성요소</data>
      <data key="d2">point-wallet 전용 포인트 캐시로, 사용자별 포인트 요약을 저장하며 다른 서비스는 사용하지 않는다.&lt;SEP&gt;redis-point는 포인트 캐시 역할을 하는 공통 구성요소이다.</data>
      <data key="d3">CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000</data>
      <data key="d4">CAT-03.txt&lt;SEP&gt;ORG-02.txt</data>
      <data key="d5">1791602883</data>
      <data key="d6" />
    </node>
    <node id="config-center">
      <data key="d0">config-center</data>
      <data key="d1">구성요소</data>
      <data key="d2">서비스 설정 값을 버전별로 보관하고 운영 환경에 배포하는 설정 관리 서버다.&lt;SEP&gt;config-center는 설정을 관리하는 서버이다.</data>
      <data key="d3">CAT-03-chunk-000&lt;SEP&gt;ORG-02-chunk-000</data>
      <data key="d4">CAT-03.txt&lt;SEP&gt;ORG-02.txt</data>
      <data key="d5">1791602883</data>
      <data key="d6" />
    </node>
    <node id="결제플랫폼팀">
      <data key="d0">결제플랫폼팀</data>
      <data key="d1">팀</data>
